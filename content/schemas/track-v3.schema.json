{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "format",
    "asset_api",
    "id",
    "version",
    "course_revision",
    "route",
    "core",
    "surface_profile"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "asset_api": {
      "const": 3
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "core": {
      "type": "object",
      "required": [
        "min",
        "max_major"
      ],
      "properties": {
        "min": {
          "type": "string"
        },
        "max_major": {
          "const": 2
        }
      }
    },
    "course_revision": {
      "type": "integer",
      "minimum": 1
    },
    "route": {
      "type": "string"
    },
    "world_kind": {
      "const": "external"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "surface_profile": {
      "const": "arcade_elevation_v1"
    },
    "authored_signage": {
      "type": "boolean",
      "default": false
    },
    "lighting": {
      "type": "object",
      "properties": {
        "sky_visual_path": {
          "type": "string"
        },
        "sky_lighting_path": {
          "type": "string"
        },
        "sky_horizon_offset": {
          "type": "number",
          "minimum": -0.25,
          "maximum": 0.25
        }
      }
    }
  }
}
