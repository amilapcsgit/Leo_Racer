{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "format",
    "vehicle_api",
    "id",
    "version",
    "core",
    "model",
    "wheels"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "vehicle_api": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "core": {
      "type": "object",
      "required": [
        "min",
        "max_major"
      ],
      "properties": {
        "min": {
          "type": "string"
        },
        "max_major": {
          "const": 2
        }
      }
    },
    "model": {
      "type": "string",
      "pattern": "^[^:]+\\.glb$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wheels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rotating",
          "pivot",
          "axle",
          "radius"
        ],
        "properties": {
          "rotating": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "stationary": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pivot": {
            "$ref": "#/$defs/vector"
          },
          "axle": {
            "$ref": "#/$defs/vector"
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    }
  }
}
