{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "format",
    "vehicle_api",
    "id",
    "version",
    "core",
    "model",
    "wheels"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "vehicle_api": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "core": {
      "type": "object",
      "required": [
        "min",
        "max_major"
      ],
      "properties": {
        "min": {
          "type": "string"
        },
        "max_major": {
          "const": 2
        }
      }
    },
    "model": {
      "type": "string",
      "pattern": "^[^:]+\\.glb$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 0
    },
    "wheels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rotating",
          "pivot",
          "axle",
          "radius"
        ],
        "properties": {
          "rotating": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "stationary": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pivot": {
            "$ref": "#/$defs/vector"
          },
          "axle": {
            "$ref": "#/$defs/vector"
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "setup_complete": {
      "const": true
    },
    "driver_policy": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3
      ]
    },
    "collision_size": {
      "$ref": "#/$defs/vector"
    },
    "collision_position": {
      "$ref": "#/$defs/vector"
    },
    "preview_target": {
      "$ref": "#/$defs/vector"
    },
    "seat": {
      "$ref": "#/$defs/transform"
    },
    "normalization": {
      "$ref": "#/$defs/transform"
    },
    "max_speed": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "boosted_speed": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "acceleration": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "handling": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "preview_distance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    }
  },
  "$defs": {
    "vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "transform": {
      "type": "object",
      "required": [
        "basis",
        "origin"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/vector"
        },
        "basis": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/vector"
          }
        }
      }
    }
  }
}
